<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Simple Calculator</title>
	<style>
		:root {
			color-scheme: light;
			font-family: Arial, sans-serif;
		}

		body {
			display: grid;
			min-height: 100vh;
			margin: 0;
			place-items: center;
			background: #eef2f7;
		}

		.calculator {
			width: min(90%, 360px);
			padding: 2rem;
			border-radius: 12px;
			background: #ffffff;
			box-shadow: 0 8px 24px rgb(0 0 0 / 12%);
		}

		h1 {
			margin-top: 0;
			text-align: center;
		}

		label,
		input,
		select,
		button {
			display: block;
			width: 100%;
			box-sizing: border-box;
		}

		label {
			margin-top: 1rem;
			margin-bottom: 0.35rem;
			font-weight: bold;
		}

		input,
		select,
		button {
			padding: 0.7rem;
			border: 1px solid #b8c2cc;
			border-radius: 6px;
			font-size: 1rem;
		}

		button {
			margin-top: 1.25rem;
			border: 0;
			color: #ffffff;
			background: #2563eb;
			cursor: pointer;
		}

		button:hover {
			background: #1d4ed8;
		}

		#result {
			min-height: 1.5rem;
			margin-bottom: 0;
			font-weight: bold;
			text-align: center;
		}
	</style>
</head>
<body>
	<main class="calculator">
		<h1>Simple Calculator</h1>

		<form id="calculator-form">
			<label for="operation">Select operation</label>
			<select id="operation" name="operation">
				<option value="add">Add</option>
				<option value="subtract">Subtract</option>
				<option value="multiply">Multiply</option>
				<option value="divide">Divide</option>
			</select>

			<label for="first-number">First number</label>
			<input id="first-number" name="first-number" type="number" step="any" required>

			<label for="second-number">Second number</label>
			<input id="second-number" name="second-number" type="number" step="any" required>

			<button type="submit">Calculate</button>
		</form>

		<p id="result" role="status" aria-live="polite"></p>
	</main>

	<script>
		const form = document.querySelector('#calculator-form');
		const result = document.querySelector('#result');

		function calculate(event) {
			event.preventDefault();

			const operation = document.querySelector('#operation').value;
			const firstNumber = Number(document.querySelector('#first-number').value);
			const secondNumber = Number(document.querySelector('#second-number').value);
			let answer;
			let symbol;

			if (operation === 'add') {
				answer = firstNumber + secondNumber;
				symbol = '+';
			} else if (operation === 'subtract') {
				answer = firstNumber - secondNumber;
				symbol = '-';
			} else if (operation === 'multiply') {
				answer = firstNumber * secondNumber;
				symbol = '*';
			} else {
				symbol = '/';
				answer = secondNumber === 0 ? 'Error! Division by zero.' : firstNumber / secondNumber;
			}

			result.textContent = `${firstNumber} ${symbol} ${secondNumber} = ${answer}`;
		}

		form.addEventListener('submit', calculate);
	</script>
</body>
</html>
